# ==========================================
# Django Core Settings
# ==========================================
SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=api.example.com,app.example.com,localhost,127.0.0.1

# ==========================================
# MySQL / AWS RDS Database Settings
# ==========================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=3306

# ==========================================
# CORS & Allowed Origins Settings
# ==========================================
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app.example.com,https://example.com

# ==========================================
# Storage Settings
# ==========================================
PERSISTENT_DATA_ROOT=/app/persistent_data

